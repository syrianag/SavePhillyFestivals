# Dependencies
node_modules/
.pnp
.pnp.js

# Next.js / Nx
.next/
.nx/
out/

# Local git worktrees. Nx scans any non-ignored directory, so leaving these
# visible registers duplicate save-philly-festivals/n8n projects and fails the
# whole project graph.
.worktrees/

# Production and test artifacts
build/
dist/
coverage/
playwright-report/
test-results/

# Environment
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Festival import reports and restricted operator artifacts
# festival-import-reports/
# *.festival-import-report.json
# *.festival-import-report.csv

# Signed import approvals, reviewer keys, and backup/restore evidence.
# Never commit — see docs/FESTIVAL-DATA-IMPORT-RUNBOOK.md and Activation-Gate.md 5.3.
restricted/

# Internal teaching reference; reused as a template in student repositories
governance-doc.md

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Editor
# .vscode/settings.json is shared on purpose: it carries the Tailwind v4 CSS-validator
# workaround, so every developer sees the same Problems panel.
.vscode/launch.json
.idea/
*.swp
*.swo
*~
.DS_Store

# Prisma
apps/save-philly-festivals/src/generated/prisma/
apps/save-philly-festivals/prisma/*.db
apps/save-philly-festivals/prisma/*.db-journal

# Misc
*.pem
*.tsbuildinfo
next-env.d.ts

# Uploads
apps/save-philly-festivals/public/uploads/

# N8N local runtime files
apps/n8n/local-files/*
!apps/n8n/local-files/.gitkeep

# Private festival source data. Contains organizer contact details and must live in
# restricted storage only. See docs/FESTIVAL-DATA-IMPORT-RUNBOOK.md.
docs/Festivals_Postgres_Export.csv
*.festival-source.csv
.vercel
.env*

