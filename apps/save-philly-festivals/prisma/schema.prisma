generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Calendar semantics ─────────────────────────────────────
enum CalendarDateType {
  timed
  all_day
}

enum CalendarStatus {
  confirmed
  tentative
  postponed
  canceled
}

enum FestivalWorkflowState {
  draft
  pending_review
  changes_requested
  approved
  rejected
  published
  unpublished
  canceled
  archived
}

enum FestivalAssetPurpose {
  logo
  hero_image
  gallery_image
}

enum FestivalAssetScanStatus {
  pending
  clean
  infected
  failed
}

enum FestivalAssetLifecycleStatus {
  active
  quarantined
  deleted
}

enum ProducerSubmissionNotificationType {
  producer_receipt
  team_notification
}

enum ProducerSubmissionNotificationStatus {
  pending
  sent
  failed
}

enum FestivalAssetReconciliationStatus {
  pending
  retrying
  cleaned
  failed
}

enum FestivalWorkflowNotificationStatus {
  pending
  sent
  failed
}

enum FestivalWorkflowNotificationAudience {
  producer
}

enum FestivalAssetEditorialStatus {
  pending
  approved
  rejected
}

enum SocialFeedProvider {
  curator
  flockler
}

enum SocialFeedSyncStatus {
  never
  success
  failed
}

enum SocialNetwork {
  instagram
  x
  facebook
  tiktok
  youtube
  other
}

enum SocialPostModerationStatus {
  pending
  approved
  hidden
  rejected
}

enum FestivalImportBatchStatus {
  prepared
  running
  completed
  failed
  rolled_back
}

enum FestivalImportRowDisposition {
  ready
  imported
  duplicate
  quarantined
  failed
}

enum FestivalImportIssueSeverity {
  warning
  error
}

enum UserAccountStatus {
  active
  deactivated
}

enum UserAccountAuditAction {
  account_created
  role_changed
  status_changed
  delete_equivalent
}

// ─── Festival ───────────────────────────────────────────────
model Festival {
  id            String   @id @default(uuid())
  name          String
  slug          String   @unique
  description   String?
  location      String?
  city          String?  @default("Philadelphia")
  state         String?  @default("PA")
  zip_code      String?
  website_url   String?
  logo_url      String?
  image_url     String?
  status        String   @default("draft")
  rejection_reason String?
  submitted_by  String?
  contact_name  String?
  contact_email String?
  contact_phone String?
  host_name     String?
  host_title    String?
  host_about    String?
  host_social   String?
  social_instagram String?
  social_facebook  String?
  social_twitter   String?
  social_tiktok    String?
  social_youtube   String?
  festival_age         String?
  festival_age_details String?
  org_type             String?
  story         String?
  mission       String?
  history       String?
  start_date            DateTime?
  end_date              DateTime?
  calendar_date_type    CalendarDateType @default(timed)
  time_zone             String           @default("America/New_York")
  all_day_start         DateTime?        @db.Date
  all_day_end           DateTime?        @db.Date
  calendar_status       CalendarStatus   @default(confirmed)
  calendar_sequence     Int              @default(0)
  calendar_published_at DateTime?
  first_published_at    DateTime?
  published_at          DateTime?
  canceled_at           DateTime?
  public_message        String?
  owner_user_id         String?
  workflow_state        FestivalWorkflowState @default(draft)
  revision              Int                   @default(0)
  submission_key        String?
  representation_acknowledged_at DateTime?
  accuracy_acknowledged_at       DateTime?
  terms_acknowledged_at          DateTime?
  terms_version                  Int?
  created_at            DateTime         @default(now())
  updated_at            DateTime         @updatedAt

  owner         User?         @relation("FestivalOwner", fields: [owner_user_id], references: [id], onDelete: Restrict)
  schedules     Schedule[]
  categories    FestivalCategory[]
  tags          FestivalTag[]
  files         FestivalFile[]
  organizer_integrations OrganizerIntegration[]
  mailing_consents OrganizerMailingConsentFestival[]
  workflow_transitions FestivalTransition[]
  private_assets FestivalAsset[]
  submission_notifications ProducerSubmissionNotification[]
  occurrences FestivalOccurrence[]
  revisions FestivalRevision[]
  workflow_notifications FestivalWorkflowNotification[]
  social_feed FestivalSocialFeed?
  import_target_rows FestivalImportRow[] @relation("FestivalImportTarget")
  import_matched_rows FestivalImportRow[] @relation("FestivalImportMatch")
  import_prepared_matched_rows FestivalImportRow[] @relation("FestivalImportPreparedMatch")

  @@unique([owner_user_id, submission_key])
  @@index([owner_user_id, workflow_state, updated_at])
  @@index([status])
  @@index([workflow_state, start_date, id])
  @@index([start_date])
  @@index([slug])
  @@index([calendar_status, calendar_published_at])
}

model FestivalSocialFeed {
  id                  String               @id @default(uuid())
  festival_id         String               @unique
  hashtag             String
  enabled             Boolean              @default(false)
  provider            SocialFeedProvider
  provider_feed_id    String
  revision          Int                  @default(0)
  source_revision   Int                  @default(1)
  sync_cursor             String?
  sync_attempt_token      String?
  sync_attempt_started_at DateTime?
  last_sync_status    SocialFeedSyncStatus @default(never)
  last_attempted_at   DateTime?
  last_success_at     DateTime?
  last_error_code     String?
  created_at          DateTime             @default(now())
  updated_at          DateTime             @updatedAt

  festival            Festival             @relation(fields: [festival_id], references: [id], onDelete: Restrict)
  posts               SocialPost[]

  @@index([enabled, last_sync_status, updated_at])
}

model SocialPost {
  id                     String                       @id @default(uuid())
  social_feed_id         String
  provider_item_id       String
  source_revision        Int                          @default(1)
  network                SocialNetwork
  canonical_url          String
  author_name            String?
  author_handle          String?
  text_excerpt           String
  source_published_at    DateTime?
  moderation_status      SocialPostModerationStatus   @default(pending)
  moderation_revision    Int                          @default(0)
  reviewed_by_user_id    String?
  reviewed_at            DateTime?
  ingested_at            DateTime                     @default(now())
  created_at             DateTime                     @default(now())
  updated_at             DateTime                     @updatedAt

  social_feed            FestivalSocialFeed           @relation(fields: [social_feed_id], references: [id], onDelete: Restrict)
  reviewer               User?                        @relation("SocialPostReviewer", fields: [reviewed_by_user_id], references: [id], onDelete: Restrict)
  moderation_transitions SocialPostModerationTransition[]

  @@unique([social_feed_id, source_revision, provider_item_id])
  @@index([social_feed_id, source_revision, moderation_status, source_published_at, id])
  @@index([reviewed_by_user_id, reviewed_at])
}

model SocialPostModerationTransition {
  id            String                     @id @default(uuid())
  social_post_id String
  actor_user_id String
  from_status   SocialPostModerationStatus
  to_status     SocialPostModerationStatus
  revision      Int
  reason        String?
  created_at    DateTime                   @default(now())

  social_post   SocialPost                 @relation(fields: [social_post_id], references: [id], onDelete: Restrict)
  actor         User                       @relation("SocialPostModerationActor", fields: [actor_user_id], references: [id], onDelete: Restrict)

  @@unique([social_post_id, revision])
  @@index([actor_user_id, created_at])
}

model FestivalImportBatch {
  id                         String                    @id @default(uuid())
  source_name                String
  source_checksum_sha256     String                    @unique
  category_map_checksum_sha256 String
  prepared_digest_sha256     String
  prepared_counts            Json
  import_profile             String
  import_profile_version     Int
  environment                String
  operator_user_id           String
  reviewer_user_id           String?
  reviewed_at                DateTime?
  reviewed_source_checksum_sha256 String?
  reviewed_category_map_checksum_sha256 String?
  reviewed_prepared_digest_sha256 String?
  reviewed_environment       String?
  review_evidence_sha256     String?
  review_approval_sha256     String?
  review_public_key_sha256   String?
  review_issued_at           DateTime?
  review_expires_at          DateTime?
  backup_provider            String?
  backup_artifact_id         String?
  backup_reference           String?
  backup_checksum_sha256     String?
  backup_version             String?
  restore_reference          String?
  restore_verified_at        DateTime?
  backup_override_reason     String?
  backup_overridden_by_user_id String?
  backup_overridden_at       DateTime?
  total_row_count            Int                       @default(0)
  ready_row_count            Int                       @default(0)
  imported_row_count         Int                       @default(0)
  duplicate_row_count        Int                       @default(0)
  quarantined_row_count      Int                       @default(0)
  failed_row_count           Int                       @default(0)
  warning_issue_count        Int                       @default(0)
  error_issue_count          Int                       @default(0)
  status                     FestivalImportBatchStatus @default(prepared)
  failure_code               String?
  failure_message            String?
  started_at                 DateTime?
  completed_at               DateTime?
  apply_attempt_token        String?                    @unique
  apply_attempt_started_at   DateTime?
  apply_attempt_heartbeat_at DateTime?
  apply_attempt_expires_at   DateTime?
  created_at                 DateTime                   @default(now())
  updated_at                 DateTime                   @updatedAt

  operator                   User                       @relation("FestivalImportOperator", fields: [operator_user_id], references: [id], onDelete: Restrict)
  reviewer                   User?                      @relation("FestivalImportReviewer", fields: [reviewer_user_id], references: [id], onDelete: Restrict)
  backup_overridden_by       User?                      @relation("FestivalImportBackupOverrideActor", fields: [backup_overridden_by_user_id], references: [id], onDelete: Restrict)
  rows                       FestivalImportRow[]
  issues                     FestivalImportIssue[]

  @@index([status, created_at])
  @@index([operator_user_id, created_at])
  @@index([reviewer_user_id, reviewed_at])
}

model FestivalImportRow {
  id                         String                       @id @default(uuid())
  batch_id                   String
  row_number                 Int
  source_record_id           String
  source_start_line          Int
  source_hash_sha256         String
  normalized_hash_sha256     String
  normalized_data            Json
  prepared_disposition       FestivalImportRowDisposition
  prepared_matched_festival_id String?
  prepared_digest_sha256     String
  disposition                FestivalImportRowDisposition @default(ready)
  target_festival_id         String?
  duplicate_of_row_id        String?
  matched_festival_id        String?
  reviewed_by_user_id        String?
  reviewed_at                DateTime?
  review_reason              String?
  match_override_reason      String?
  match_overridden_by_user_id String?
  match_overridden_at        DateTime?
  created_at                 DateTime                     @default(now())
  updated_at                 DateTime                     @updatedAt

  batch                      FestivalImportBatch          @relation(fields: [batch_id], references: [id], onDelete: Restrict)
  target_festival            Festival?                    @relation("FestivalImportTarget", fields: [target_festival_id], references: [id], onDelete: Restrict)
  duplicate_of_row           FestivalImportRow?           @relation("FestivalImportDuplicate", fields: [duplicate_of_row_id], references: [id], onDelete: Restrict)
  duplicate_rows             FestivalImportRow[]          @relation("FestivalImportDuplicate")
  matched_festival           Festival?                    @relation("FestivalImportMatch", fields: [matched_festival_id], references: [id], onDelete: Restrict)
  prepared_matched_festival  Festival?                    @relation("FestivalImportPreparedMatch", fields: [prepared_matched_festival_id], references: [id], onDelete: Restrict)
  reviewer                   User?                        @relation("FestivalImportRowReviewer", fields: [reviewed_by_user_id], references: [id], onDelete: Restrict)
  match_overridden_by        User?                        @relation("FestivalImportMatchOverrideActor", fields: [match_overridden_by_user_id], references: [id], onDelete: Restrict)
  issues                     FestivalImportIssue[]

  @@unique([batch_id, row_number])
  @@unique([id, batch_id])
  @@index([batch_id, disposition, row_number])
  @@index([duplicate_of_row_id])
  @@index([matched_festival_id])
  @@index([reviewed_by_user_id, reviewed_at])
}

model FestivalImportIssue {
  id            String                      @id @default(uuid())
  batch_id      String
  row_id        String?
  severity      FestivalImportIssueSeverity
  code          String
  field         String?
  message       String
  safe_details  Json?
  created_at    DateTime                    @default(now())

  batch         FestivalImportBatch         @relation(fields: [batch_id], references: [id], onDelete: Restrict)
  row           FestivalImportRow?          @relation(fields: [row_id, batch_id], references: [id, batch_id], onDelete: Restrict)

  @@index([batch_id, severity, code])
  @@index([row_id, severity])
}

model FestivalTransition {
  id            String                @id @default(uuid())
  festival_id   String
  actor_user_id String
  from_state    FestivalWorkflowState?
  to_state      FestivalWorkflowState
  revision      Int
  reason           String?
  producer_message String?
  public_message   String?
  created_at       DateTime              @default(now())

  festival      Festival @relation(fields: [festival_id], references: [id], onDelete: Restrict)
  actor          User     @relation("FestivalTransitionActor", fields: [actor_user_id], references: [id], onDelete: Restrict)
  snapshot       FestivalRevision?

  @@unique([festival_id, revision])
  @@unique([id, festival_id, revision, actor_user_id])
  @@index([actor_user_id, created_at])
}

model FestivalAsset {
  id                     String                       @id @default(uuid())
  festival_id            String
  uploader_user_id       String
  drive_file_id          String                       @unique
  server_filename        String
  original_filename      String
  mime_type              String
  byte_size              Int
  checksum_sha256        String
  purpose                FestivalAssetPurpose
  alt_text               String
  rights_version         Int
  rights_acknowledged_at DateTime
  provider_md5_checksum  String?
  provider_version       String?
  scan_status            FestivalAssetScanStatus      @default(pending)
  lifecycle_status       FestivalAssetLifecycleStatus @default(active)
  editorial_status       FestivalAssetEditorialStatus @default(pending)
  reviewed_by_user_id    String?
  reviewed_at            DateTime?
  editorial_reason       String?
  created_at             DateTime                     @default(now())
  updated_at             DateTime                     @updatedAt

  festival               Festival @relation(fields: [festival_id], references: [id], onDelete: Restrict)
  uploader               User     @relation("FestivalAssetUploader", fields: [uploader_user_id], references: [id], onDelete: Restrict)
  reviewer               User?    @relation("FestivalAssetReviewer", fields: [reviewed_by_user_id], references: [id], onDelete: Restrict)

  @@index([festival_id, lifecycle_status, editorial_status, created_at])
  @@index([uploader_user_id, created_at])
  @@index([scan_status, created_at])
}

model FestivalAssetReconciliation {
  id                  String                            @id @default(uuid())
  reconciliation_marker String                          @unique
  provider_file_id    String                            @unique
  server_filename     String
  checksum_sha256     String
  cleanup_status      FestivalAssetReconciliationStatus @default(pending)
  cleanup_attempts    Int                               @default(0)
  last_error_code     String?
  last_attempted_at   DateTime?
  cleaned_at          DateTime?
  created_at          DateTime                          @default(now())
  updated_at          DateTime                          @updatedAt

  @@index([cleanup_status, created_at])
}

model ProducerSubmissionNotification {
  id                  String                               @id @default(uuid())
  festival_id         String
  workflow_revision   Int
  notification_type   ProducerSubmissionNotificationType
  delivery_status     ProducerSubmissionNotificationStatus @default(pending)
  recipient_email     String?
  recipient_alias     String?
  attempts            Int                                  @default(0)
  provider_message_id String?
  failure_code        String?
  attempt_token       String?                                @unique
  attempt_started_at  DateTime?
  attempted_at        DateTime?
  sent_at             DateTime?
  created_at          DateTime                             @default(now())
  updated_at          DateTime                             @updatedAt

  festival            Festival @relation(fields: [festival_id], references: [id], onDelete: Restrict)

  @@unique([festival_id, workflow_revision, notification_type])
  @@index([delivery_status, created_at])
}

model FestivalOccurrence {
  id                    String           @id @default(uuid())
  festival_id           String
  source_key            String?
  is_primary            Boolean          @default(false)
  calendar_date_type    CalendarDateType @default(timed)
  time_zone             String           @default("America/New_York")
  start_at              DateTime?
  end_at                DateTime?
  all_day_start         DateTime?         @db.Date
  all_day_end           DateTime?         @db.Date
  calendar_status       CalendarStatus   @default(confirmed)
  calendar_sequence     Int              @default(0)
  calendar_published_at DateTime?
  created_at            DateTime         @default(now())
  updated_at            DateTime         @updatedAt

  festival Festival   @relation(fields: [festival_id], references: [id], onDelete: Restrict)
  schedules Schedule[]

  @@unique([festival_id, source_key])
  @@unique([id, festival_id])
  @@index([festival_id, is_primary])
  @@index([calendar_status, calendar_published_at])
}

model FestivalRevision {
  id                 String   @id @default(uuid())
  festival_id        String
  workflow_revision  Int
  transition_id      String   @unique
  actor_user_id      String
  snapshot           Json
  created_at         DateTime @default(now())

  festival   Festival           @relation(fields: [festival_id], references: [id], onDelete: Restrict)
  transition FestivalTransition @relation(fields: [transition_id, festival_id, workflow_revision, actor_user_id], references: [id, festival_id, revision, actor_user_id], onDelete: Restrict)
  actor      User               @relation("FestivalRevisionActor", fields: [actor_user_id], references: [id], onDelete: Restrict)

  @@unique([festival_id, workflow_revision])
  @@unique([transition_id, festival_id, workflow_revision, actor_user_id])
  @@index([actor_user_id, created_at])
}

model FestivalWorkflowNotification {
  id                  String                               @id @default(uuid())
  festival_id         String
  workflow_revision   Int
  audience            FestivalWorkflowNotificationAudience @default(producer)
  delivery_status     FestivalWorkflowNotificationStatus   @default(pending)
  recipient_email     String?
  attempts            Int                                  @default(0)
  provider_message_id String?
  failure_code        String?
  attempt_token       String?                              @unique
  attempt_started_at  DateTime?
  attempted_at        DateTime?
  sent_at             DateTime?
  created_at          DateTime                             @default(now())
  updated_at          DateTime                             @updatedAt

  festival Festival @relation(fields: [festival_id], references: [id], onDelete: Restrict)

  @@unique([festival_id, workflow_revision, audience])
  @@index([delivery_status, created_at])
}

// ─── Schedule (individual events within a festival) ────────
model Schedule {
  id            String   @id @default(uuid())
  festival_id   String
  occurrence_id String?
  title         String
  description   String?
  location      String?
  start_time            DateTime?
  end_time              DateTime?
  calendar_date_type    CalendarDateType @default(timed)
  time_zone             String           @default("America/New_York")
  all_day_start         DateTime?        @db.Date
  all_day_end           DateTime?        @db.Date
  calendar_status       CalendarStatus   @default(confirmed)
  calendar_sequence     Int              @default(0)
  calendar_published_at DateTime?
  performer     String?
  genre         String?
  is_headliner  Boolean  @default(false)
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  festival      Festival            @relation(fields: [festival_id], references: [id], onDelete: Cascade)
  occurrence    FestivalOccurrence? @relation(fields: [occurrence_id, festival_id], references: [id, festival_id], onDelete: Restrict)
  saved_schedules SavedSchedule[]

  @@index([festival_id])
  @@index([occurrence_id, festival_id])
  @@index([start_time])
  @@index([calendar_status, calendar_published_at])
}

// ─── Saved Schedule (user's personalized schedule) ─────────
model SavedSchedule {
  id            String   @id @default(uuid())
  user_email    String
  schedule_id   String
  created_at    DateTime @default(now())

  schedule      Schedule @relation(fields: [schedule_id], references: [id], onDelete: Cascade)

  @@unique([user_email, schedule_id])
  @@index([user_email])
}

// ─── Transactional mixed-schedule email requests ────────────
enum ScheduleEmailDeliveryStatus {
  pending
  sent
  failed
}

enum ScheduleEmailItemType {
  festival
  event
}

enum ScheduleEmailResolutionStatus {
  resolved
  unavailable
}

model ScheduleEmailRequest {
  id                  String                       @id @default(uuid())
  recipient_email     String
  idempotency_key     String                       @unique
  selection_version   Int
  delivery_status     ScheduleEmailDeliveryStatus @default(pending)
  provider_message_id String?
  failure_code        String?
  failure_message     String?
  attempts            Int                          @default(0)
  attempt_token       String?                      @unique
  attempt_started_at  DateTime?
  attempted_at        DateTime?
  sent_at             DateTime?
  created_at          DateTime                     @default(now())
  updated_at          DateTime                     @updatedAt

  items               ScheduleEmailItem[]

  @@index([recipient_email])
  @@index([delivery_status, created_at])
  @@index([delivery_status, attempt_started_at])
}

model ScheduleEmailItem {
  id                String                        @id @default(uuid())
  request_id        String
  position          Int
  item_type         ScheduleEmailItemType
  item_id           String
  resolution_status ScheduleEmailResolutionStatus

  request           ScheduleEmailRequest @relation(fields: [request_id], references: [id], onDelete: Cascade)

  @@unique([request_id, position])
  @@unique([request_id, item_type, item_id])
  @@index([item_type, item_id])
}

// ─── Organizer mailing consent and N8N outbox ───────────────
enum OrganizerAuthorizationStatus {
  authorized
  revoked
}

enum OrganizerConsentPreference {
  reminders
  updates
  discovery
}

enum OrganizerOutboxStatus {
  pending
  processing
  completed
  failed
  suppressed
}

model OrganizerIntegration {
  id                       String                        @id @default(uuid())
  festival_id              String
  organizer_name           String
  enabled                  Boolean                       @default(false)
  authorization_status     OrganizerAuthorizationStatus @default(revoked)
  authorization_granted_at DateTime?
  authorization_revoked_at DateTime?
  created_at               DateTime                      @default(now())
  updated_at               DateTime                      @updatedAt

  festival                 Festival                      @relation(fields: [festival_id], references: [id], onDelete: Cascade)
  consents                 OrganizerMailingConsentOrganizer[]
  outbox_items             OrganizerMailingOutbox[]
  suppressions             OrganizerMailingSuppression[]

  @@index([festival_id])
  @@index([enabled, authorization_status])
}

model OrganizerMailingConsent {
  id                    String                           @id @default(uuid())
  submission_key        String                           @unique
  request_fingerprint   String
  normalized_email      String
  consent_text          String
  consent_version       Int
  preference_version    Int
  source                String
  request_ip            String
  consented_at          DateTime                         @default(now())
  revoked_at            DateTime?
  suppressed_at         DateTime?
  suppression_reason    String?
  management_token_hash String                           @unique
  created_at            DateTime                         @default(now())
  updated_at            DateTime                         @updatedAt

  festivals             OrganizerMailingConsentFestival[]
  organizers            OrganizerMailingConsentOrganizer[]
  preferences           OrganizerMailingConsentPreferenceRecord[]
  outbox_items           OrganizerMailingOutbox[]

  @@index([normalized_email])
  @@index([revoked_at, suppressed_at])
}

model OrganizerMailingConsentFestival {
  consent_id  String
  festival_id String

  consent     OrganizerMailingConsent @relation(fields: [consent_id], references: [id], onDelete: Cascade)
  festival    Festival                @relation(fields: [festival_id], references: [id], onDelete: Restrict)

  @@id([consent_id, festival_id])
}

model OrganizerMailingConsentOrganizer {
  consent_id              String
  organizer_integration_id String
  revoked_at              DateTime?
  suppressed_at           DateTime?

  consent                 OrganizerMailingConsent @relation(fields: [consent_id], references: [id], onDelete: Cascade)
  organizer_integration   OrganizerIntegration     @relation(fields: [organizer_integration_id], references: [id], onDelete: Restrict)

  @@id([consent_id, organizer_integration_id])
  @@index([organizer_integration_id, revoked_at, suppressed_at])
}

model OrganizerMailingConsentPreferenceRecord {
  consent_id String
  preference OrganizerConsentPreference

  consent    OrganizerMailingConsent @relation(fields: [consent_id], references: [id], onDelete: Cascade)

  @@id([consent_id, preference])
}

model OrganizerMailingSuppression {
  id                       String               @id @default(uuid())
  normalized_email         String
  organizer_integration_id String
  reason                   String
  created_at               DateTime             @default(now())

  organizer_integration    OrganizerIntegration @relation(fields: [organizer_integration_id], references: [id], onDelete: Restrict)

  @@unique([normalized_email, organizer_integration_id])
  @@index([organizer_integration_id])
}

model OrganizerMailingOutbox {
  id                       String                @id @default(uuid())
  consent_id               String
  organizer_integration_id String
  idempotency_key          String                @unique
  status                   OrganizerOutboxStatus @default(pending)
  attempts                 Int                   @default(0)
  max_attempts             Int                   @default(5)
  next_attempt_at          DateTime               @default(now())
  lease_token_hash         String?
  lease_expires_at         DateTime?
  provider_result_id       String?
  last_error_code          String?
  completed_at             DateTime?
  suppressed_at            DateTime?
  created_at               DateTime               @default(now())
  updated_at               DateTime               @updatedAt

  consent                  OrganizerMailingConsent @relation(fields: [consent_id], references: [id], onDelete: Cascade)
  organizer_integration    OrganizerIntegration     @relation(fields: [organizer_integration_id], references: [id], onDelete: Restrict)

  @@unique([consent_id, organizer_integration_id])
  @@index([status, next_attempt_at])
  @@index([lease_expires_at])
}

// ─── Category ──────────────────────────────────────────────
model Category {
  id            String   @id @default(uuid())
  name          String   @unique
  slug          String   @unique
  description   String?

  festivals     FestivalCategory[]
}

model FestivalCategory {
  festival_id   String
  category_id   String

  festival      Festival   @relation(fields: [festival_id], references: [id], onDelete: Cascade)
  category      Category   @relation(fields: [category_id], references: [id], onDelete: Cascade)

  @@id([festival_id, category_id])
}

// ─── Tag ───────────────────────────────────────────────────
model Tag {
  id            String   @id @default(uuid())
  name          String   @unique
  slug          String   @unique

  festivals     FestivalTag[]
}

model FestivalTag {
  festival_id   String
  tag_id        String

  festival      Festival   @relation(fields: [festival_id], references: [id], onDelete: Cascade)
  tag           Tag        @relation(fields: [tag_id], references: [id], onDelete: Cascade)

  @@id([festival_id, tag_id])
}

// ─── Festival File Uploads ─────────────────────────────────
model FestivalFile {
  id            String   @id @default(uuid())
  festival_id   String
  file_name     String
  file_url      String
  file_type     String
  file_size     Int?
  uploaded_at   DateTime @default(now())

  festival      Festival @relation(fields: [festival_id], references: [id], onDelete: Cascade)

  @@index([festival_id])
}

// ─── Auth (NextAuth.js) ────────────────────────────────────
model User {
  id            String   @id @default(uuid())
  name          String?
  email         String   @unique
  email_verified DateTime?
  password_hash String
  role          String            @default("public")
  status        UserAccountStatus @default(active)
  revision      Int               @default(0)
  deactivated_at DateTime?
  image         String?
  created_at    DateTime          @default(now())
  updated_at    DateTime          @updatedAt

  sessions      Session[]
  accounts      Account[]
  owned_festivals Festival[]          @relation("FestivalOwner")
  festival_transitions FestivalTransition[] @relation("FestivalTransitionActor")
  uploaded_festival_assets FestivalAsset[] @relation("FestivalAssetUploader")
  reviewed_festival_assets FestivalAsset[] @relation("FestivalAssetReviewer")
  festival_revisions FestivalRevision[] @relation("FestivalRevisionActor")
  reviewed_social_posts SocialPost[] @relation("SocialPostReviewer")
  social_post_moderation_transitions SocialPostModerationTransition[] @relation("SocialPostModerationActor")
  operated_festival_import_batches FestivalImportBatch[] @relation("FestivalImportOperator")
  reviewed_festival_import_batches FestivalImportBatch[] @relation("FestivalImportReviewer")
  overridden_festival_import_backups FestivalImportBatch[] @relation("FestivalImportBackupOverrideActor")
  reviewed_festival_import_rows FestivalImportRow[] @relation("FestivalImportRowReviewer")
  overridden_festival_import_matches FestivalImportRow[] @relation("FestivalImportMatchOverrideActor")
  account_transitions UserAccountTransition[] @relation("UserAccountTransitionTarget")
  performed_account_transitions UserAccountTransition[] @relation("UserAccountTransitionActor")

  @@index([status, role, created_at])
}

model UserAccountTransition {
  id            String                 @id @default(uuid())
  user_id       String
  actor_user_id String
  action        UserAccountAuditAction
  from_role     String?
  to_role       String?
  from_status   UserAccountStatus?
  to_status     UserAccountStatus?
  revision      Int
  reason        String?
  created_at    DateTime               @default(now())

  user          User @relation("UserAccountTransitionTarget", fields: [user_id], references: [id], onDelete: Restrict)
  actor         User @relation("UserAccountTransitionActor", fields: [actor_user_id], references: [id], onDelete: Restrict)

  @@unique([user_id, revision])
  @@index([actor_user_id, created_at])
  @@index([user_id, created_at])
}

model Account {
  id                String  @id @default(uuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(uuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─── Email Log ─────────────────────────────────────────────
model EmailLog {
  id            String   @id @default(uuid())
  to_email      String
  subject       String
  template      String
  status        String   @default("sent")
  sent_at       DateTime @default(now())
  error_message String?

  @@index([to_email])
  @@index([sent_at])
}
