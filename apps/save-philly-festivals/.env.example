# ─────────────────────────────────────────────────────────────────────────────
# Save Philly Festivals — environment reference
#
# The app reads `apps/save-philly-festivals/.env.local` first, then `.env`.
# Copy this file to `.env.local` and fill in real values there. `.env.local` is
# gitignored; this file is committed, so it must never contain a real value.
#
# Every variable below is one the code actually reads. Verify after editing:
#   pnpm run check && pnpm run dev
# ─────────────────────────────────────────────────────────────────────────────


# ── Required to boot ─────────────────────────────────────────────────────────

# Postgres connection string. Used by the runtime driver adapter (src/lib/db.js)
# and by every Prisma CLI command through prisma.config.ts.
DATABASE_URL="postgresql://user:password@localhost:5432/philly_fests"

# Auth.js v5 signing secret. src/lib/auth.js THROWS AT IMPORT TIME without it,
# so the app will not start at all until this is set.
#   Generate with: pnpm run auth:secret
AUTH_SECRET=""

# Canonical public origin. Also the origin every mutation is checked against —
# if this is wrong or unset in production, writes are rejected 403 as
# cross-origin. No trailing slash.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"


# ── Production hardening: edge rate limit attestation ────────────────────────
#
# These three flags make production mutations FAIL CLOSED (503
# `edge_rate_limit_unverified`) until an operator confirms that identity/IP-aware
# rate limiting is independently enabled at the deployment edge.
#
# Setting a flag does NOT create protection — it asserts protection exists. Do
# not set them until the edge rules are live AND enforcing. In development the
# gates pass automatically, so these are only meaningful in production.
#
# Check the assertion is true rather than remembering it:
#   pnpm run ops:firewall:verify
#
# Note: changing these in the hosting dashboard has no effect on running
# functions until the NEXT DEPLOYMENT.
#
# Producer submissions, uploads, admin editorial publishing, /api/producer/apply
# PRODUCER_EDGE_RATE_LIMIT_VERIFIED=1
# Schedule email and organizer consent (unauthenticated public writes)
# PUBLIC_MUTATION_EDGE_RATE_LIMIT_VERIFIED=1
# Staff and producer account management
# USER_MANAGEMENT_EDGE_RATE_LIMIT_VERIFIED=1


# ── Transactional email (Resend) ─────────────────────────────────────────────
#
# Both credentials are required before any account email is sent.
# RESEND_API_KEY=
# RESEND_FROM_EMAIL=noreply@savephillyfestivals.com

# ACCOUNT_EMAILS_ENABLED gates producer-access decision emails ONLY, separately from the
# festival workflow notifications that also send through Resend. That separation is deliberate:
# festival notifications are addressed to organizer contact details imported from the source
# spreadsheet, and turning on account emails must not arm those. Leave this unset until you
# have decided, explicitly, that organizers may be emailed.
# ACCOUNT_EMAILS_ENABLED=0

# PASSWORD_RESET_EMAILS_ENABLED gates the "forgot password" email, and nothing else. It is separate
# from ACCOUNT_EMAILS_ENABLED on purpose: account recovery is the one email a deployment should be
# able to send while every other category stays off, and requiring the broader flag would mean a
# locked-out admin had to arm organizer mail to get back in. Without this set to 1, the reset
# endpoint still accepts requests and still reports success — it must not reveal which addresses
# are registered — so no reset email is ever delivered. Set it before relying on self-service reset.
# PASSWORD_RESET_EMAILS_ENABLED=0

# Internal address that receives a copy of each producer submission notification.
# Unset means the team copy is skipped; producer-facing mail is unaffected.
# PRODUCER_SUBMISSION_TEAM_ALIAS=festivals@example.com


# ── Bearer secrets for internal and machine-called endpoints ─────────────────
#
# Each guards a route that writes data or spends a third-party quota, so an
# unauthenticated caller could do real damage. Generate each independently:
#   openssl rand -base64 32

# /api/internal/geocode/sweep — called by the cron in vercel.json. Writes festival
# coordinates and spends a rate-limited Nominatim quota.
# GEOCODE_SWEEP_SECRET=

# /api/internal/social-feeds/[feedId]/sync — triggers a provider fetch.
# SOCIAL_FEED_SYNC_SECRET=

# /api/internal/n8n/organizer-subscriptions/* — claim and report endpoints the N8N
# organizer mailing workflow calls.
# N8N_ORGANIZER_OUTBOX_SECRET=


# ── Social feed providers ────────────────────────────────────────────────────
#
# Only the provider configured per festival is used; leave the other unset.
# CURATOR_SOCIAL_FEED_TOKEN=
# FLOCKLER_SOCIAL_FEED_TOKEN=


# ── Private asset uploads (Google Drive) ─────────────────────────────────────
#
# Producer uploads go to a private Drive folder rather than public object storage.
# Uploads stay disabled unless GOOGLE_DRIVE_UPLOADS_ENABLED is exactly "1".
# GOOGLE_DRIVE_UPLOADS_ENABLED=0
# GOOGLE_DRIVE_SERVICE_ACCOUNT_EMAIL=service-account@project.iam.gserviceaccount.com
# The full PEM including header and footer, newlines escaped as \n.
# GOOGLE_DRIVE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# GOOGLE_DRIVE_PRIVATE_FOLDER_ID=


# ── Festival import review ───────────────────────────────────────────────────
#
# Public key used by scripts/festival-import.mjs to verify the signed reviewer
# approval before an import batch may be applied. See Activation-Gate.md.
# FESTIVAL_IMPORT_REVIEW_PUBLIC_KEY=

# Absolute path to the restricted source CSV. The reviewed export carries organizer
# contact details and is gitignored, so tests/unit/festival-import-profile.test.js
# SKIPS its checksum-pinned profile assertion unless the file is present. Set this
# only if you hold the restricted copy outside the default docs/ location.
# FESTIVAL_IMPORT_SOURCE_FILE=/absolute/path/to/Festivals_Postgres_Export.csv


# ── Client IP resolution behind a proxy ──────────────────────────────────────
#
# How many hops to trust from the right of `x-forwarded-for` when deriving the
# client address for public-write rate limiting. Too high lets a caller spoof
# their address and evade the limiter; leave unset unless you run a known proxy
# chain.
# TRUSTED_PROXY_HOPS=1
# Legacy name, still read as a fallback when TRUSTED_PROXY_HOPS is unset. Prefer the
# name above for new deployments.
# CONSENT_TRUSTED_PROXY_HOPS=1


# ── Local seed credentials ───────────────────────────────────────────────────
#
# Required by `pnpm run db:seed` — there are deliberately no fallback passwords,
# and tests/unit/security-contract.test.js asserts that stays true.
LOCAL_ADMIN_EMAIL="admin@example.test"
LOCAL_ADMIN_PASSWORD="replace-with-a-unique-local-password"
LOCAL_PRODUCER_EMAIL="producer@example.test"
LOCAL_PRODUCER_PASSWORD="replace-with-a-different-local-password"


# ── Demo and development toggles ─────────────────────────────────────────────

# Sponsor ad slot — fills the footer sponsor band with demo creatives so the client can
# see a sold page before any sponsor is signed. Never set in production: the businesses
# are invented and the links point at example.com.
# SPONSOR_DEMO=1


# ── E2E fixtures — NEVER set these in production ─────────────────────────────
#
# Each swaps a real dependency for a fake one (repository, session, mail). They
# are set automatically by playwright.config.js; you only need them by hand when
# driving the app manually against fixture data. Any of them set in production
# would bypass authentication or database access entirely.
# DISCOVERY_E2E_FIXTURE=1
# NAVIGATION_E2E_FIXTURE=1
# PRODUCER_E2E_FIXTURE=1
# PASSWORD_RESET_E2E_FIXTURE=1
# Must be at least 32 characters; playwright.config.js generates one per run.
# PRODUCER_E2E_SECRET=

# Narrows the Playwright browser matrix. Unset runs Chromium and Firefox — the
# only browsers CI installs.
# E2E_BROWSERS=chromium


# ── Local tooling ────────────────────────────────────────────────────────────

# Overrides the production URL that `pnpm run ops:firewall:verify` probes.
# Defaults to https://<vercel-project-name>.vercel.app
# PRODUCTION_URL=

# Used by tools/scripts/md-to-pdf.mjs when Chrome is not on the default path.
# CHROME_PATH=/usr/bin/chromium

# N8N ops helpers (tools/scripts/n8n-ops.mjs). The N8N app has its own
# apps/n8n/.env.example for the container's own configuration.
# N8N_URL=http://localhost:5678
# N8N_HEALTH_PATH=/healthz


# ── Set by the platform — do NOT put these in an env file ────────────────────
#
# NODE_ENV   Next/Vite reject NODE_ENV=production in an env file with an explicit
#            error. Pass it as a shell variable instead:
#              NODE_ENV=production pnpm run build
# PORT       Set by the host, or inline for a one-off: PORT=3001 pnpm run dev:web
# CI         Set by the CI runner; playwright.config.js reads it for retries.
# VERCEL_URL, VERCEL_PROJECT_PRODUCTION_URL
#            Injected by Vercel at build and runtime.
#
# CONFIRM_DEPLOY and CONFIRM_FIREWALL are command-line confirmation gates, not
# configuration. Pass them inline on the one command that needs them, e.g.
#   CONFIRM_FIREWALL=stage pnpm run ops:firewall:stage
# Putting them in an env file defeats the entire point of the gate.
