# Copy with `npm run n8n:init`; that command generates both secret values.
N8N_URL=http://localhost:5678
N8N_HEALTH_PATH=/healthz
N8N_HOST=localhost
N8N_PROTOCOL=http
N8N_SECURE_COOKIE=false
GENERIC_TIMEZONE=America/New_York
N8N_POSTGRES_PASSWORD=replace-with-generated-value
N8N_ENCRYPTION_KEY=replace-with-generated-value
