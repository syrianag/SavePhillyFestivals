# Copy to .env.production on the DigitalOcean host. Never commit real values.
N8N_POSTGRES_PASSWORD=replace-with-a-long-random-value
N8N_ENCRYPTION_KEY=replace-with-a-stable-escrowed-random-value
N8N_HOST=n8n.example.org
N8N_URL=https://n8n.example.org
N8N_PROTOCOL=https
N8N_SECURE_COOKIE=true
GENERIC_TIMEZONE=America/New_York
EXECUTIONS_DATA_MAX_AGE=336

# Portable workflow bindings configured after inactive import.
DIASPORA_DNA_SHEET_ID=configure-in-production
DIASPORA_DNA_SHEET_NAME=Outreach Queue
DIASPORA_DNA_MODEL_NAME=verify-in-n8n-before-activation
