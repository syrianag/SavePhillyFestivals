generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// User roles for access control
enum Role {
  ADMIN
  HOST
  CRM
}

// Festival lifecycle status
enum FestivalStatus {
  DRAFT
  PUBLISHED
  CANCELLED
}

// CRM contact status
enum ContactStatus {
  NEW
  CONTACTED
  RESOLVED
}

// Platform users (admin, hosts, CRM staff)
model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String
  role      Role     @default(HOST)

  festivals  Festival[] // Festivals managed by this host
  contacts   Contact[]  // Contacts assigned to this CRM user

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Festival events managed by hosts
model Festival {
  id          String         @id @default(cuid())
  title       String
  description String?
  location    String
  startDate   DateTime
  endDate     DateTime?
  image       String?
  status      FestivalStatus @default(DRAFT)

  hostId String
  host   User      @relation(fields: [hostId], references: [id])

  schedules Schedule[]
  contacts  Contact[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Daily schedule/lineup for a festival
model Schedule {
  id          String   @id @default(cuid())
  day         DateTime
  startTime   String
  endTime     String?
  activity    String
  description String?

  festivalId String
  festival   Festival @relation(fields: [festivalId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// CRM contact inquiries
model Contact {
  id        String        @id @default(cuid())
  name      String
  email     String
  message   String
  status    ContactStatus @default(NEW)

  festivalId   String?
  festival     Festival? @relation(fields: [festivalId], references: [id])
  assignedToId String?
  assignedTo   User?     @relation(fields: [assignedToId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
