{
  "name": "save-philly-festivals",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.13.0",
  "engines": {
    "node": ">=20.19",
    "pnpm": ">=11.13.0"
  },
  "//": "No `nx` key here on purpose. liftOff-ops needs `nx.includedScripts: []` because its workspace root is itself an Nx project (root project.json); this workspace has no root project, so adding an `nx` key would register the root as a project named save-philly-festivals and collide with apps/save-philly-festivals. Root scripts here are plain pnpm entry points and are never inferred as Nx targets.",
  "scripts": {
    "check": "nx run-many -t lint typecheck --all",
    "predev": "pnpm run check",
    "dev": "nx run save-philly-festivals:dev",
    "dev:web": "nx run save-philly-festivals:dev",
    "build": "nx run-many -t build --all",
    "build:web": "nx run save-philly-festivals:build",
    "start": "nx run save-philly-festivals:start",
    "preview": "nx run save-philly-festivals:start",
    "lint": "nx run-many -t lint --all",
    "lint:web": "nx run save-philly-festivals:lint",
    "typecheck": "nx run-many -t typecheck --all",
    "typecheck:web": "nx run save-philly-festivals:typecheck",
    "test": "nx run-many -t test --all",
    "test:web": "nx run save-philly-festivals:test",
    "test:n8n": "nx run n8n:test",
    "test:coverage": "nx run save-philly-festivals:test-coverage",
    "e2e": "nx run save-philly-festivals:e2e",
    "verify": "nx run save-philly-festivals:prisma-validate --outputStyle=static && nx run save-philly-festivals:audit --outputStyle=static && nx run save-philly-festivals:test-coverage --outputStyle=static && nx run n8n:test --outputStyle=static && nx run n8n:validate --outputStyle=static && nx run-many -t lint build --projects=save-philly-festivals --outputStyle=static",
    "db:generate": "nx run save-philly-festivals:prisma-generate",
    "db:validate": "nx run save-philly-festivals:prisma-validate",
    "db:migrate:test": "nx run save-philly-festivals:migrate-test",
    "db:migrate:deploy": "prisma migrate deploy --config apps/save-philly-festivals/prisma.config.ts",
    "db:seed": "nx run save-philly-festivals:seed",
    "db:verify-admin": "nx run save-philly-festivals:verify-seeded-admin",
    "db:ensure-import-categories": "nx run save-philly-festivals:ensure-import-categories",
    "migrate:test": "nx run save-philly-festivals:migrate-test",
    "deploy": "pnpm run deploy:web",
    "deploy:preflight": "pnpm run verify",
    "deploy:web": "sh -c 'command -v gh >/dev/null 2>&1 || { echo \"GitHub CLI (gh) is required to dispatch the gated production workflow. Install it from https://cli.github.com, or run the Deploy workflow from the GitHub Actions UI.\" >&2; exit 1; }; [ -n \"$RELEASE_SHA\" ] || { echo \"RELEASE_SHA is required: the exact commit SHA that passed all merge gates.\" >&2; exit 1; }; [ -n \"$BACKUP_REFERENCE\" ] || { echo \"BACKUP_REFERENCE is required: the verified database backup taken before this release.\" >&2; exit 1; }; gh workflow run deploy.yml -f release_sha=\"$RELEASE_SHA\" -f backup_reference=\"$BACKUP_REFERENCE\"'",
    "deploy:n8n": "nx run n8n:deploy",
    "festival:import": "nx run save-philly-festivals:festival-import",
    "festival:publish-batch": "nx run save-philly-festivals:festival-publish-batch",
    "festival:geocode": "nx run save-philly-festivals:festival-geocode",
    "festival:import:test": "nx run save-philly-festivals:festival-import-test",
    "postinstall": "prisma generate --config apps/save-philly-festivals/prisma.config.ts",
    "auth:secret": "nx run save-philly-festivals:auth-secret",
    "n8n:init": "nx run n8n:init",
    "n8n:validate": "nx run n8n:validate",
    "n8n:validate:production": "nx run n8n:validate-production",
    "n8n:test": "nx run n8n:test",
    "n8n:health": "nx run n8n:health",
    "n8n:plan": "nx run n8n:plan",
    "n8n:deploy": "nx run n8n:deploy",
    "n8n:stop": "nx run n8n:stop",
    "n8n:logs": "nx run n8n:logs",
    "ops:validate": "nx run-many -t validate --all",
    "ops:health": "nx run-many -t health --all"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@hookform/resolvers": "^5.4.0",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^17.4.2",
    "gh": "^2.8.9",
    "ics": "^3.12.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.23.0",
    "next": "^16.3.0",
    "next-auth": "^5.0.0-beta.31",
    "pg": "^8.22.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.82.0",
    "resend": "^6.18.0",
    "shadcn": "^4.13.0",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "uuid": "^14.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4.0.0",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^9.0.0",
    "eslint-config-next": "^16.3.0",
    "nx": "22.7.8",
    "prisma": "^7.9.1",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.23.5",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "nx": {
      "brace-expansion": "5.0.9"
    }
  }
}
